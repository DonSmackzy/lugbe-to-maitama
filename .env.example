# =============================================================================
# Lugbe to Maitama — Environment Configuration Reference (.env.example)
# Copy this file to .env before starting services locally or in production.
# NEVER commit production secrets or real API keys to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# -----------------------------------------------------------------------------
# Connection URI for the append-only ledger and persistent save store.
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://ltm_user:ltm_dev_secret@localhost:5432/ltm_db

# -----------------------------------------------------------------------------
# 2. Redis Configuration
# -----------------------------------------------------------------------------
# Used for Colyseus room presence, crash-recovery snapshots, sliding-window
# rate limiting, and Fastify AI anti-stampede caching.
REDIS_URL=redis://:ltm_redis_secret@localhost:6379

# -----------------------------------------------------------------------------
# 3. Colyseus Authoritative Game Server (apps/server)
# -----------------------------------------------------------------------------
# Port for Colyseus WebSocket server and HTTP health endpoints
PORT=2567
NODE_ENV=development

# Internal server secret for room token signing
SERVER_SECRET=ltm_supersecret_change_me_in_production

# URL of the downstream Fastify AI Dialogue microservice
AI_SERVICE_URL=http://localhost:3001

# Shared secret key passed in the 'x-internal-key' header to the AI service
AI_INTERNAL_KEY=ltm_internal_service_token_2026

# -----------------------------------------------------------------------------
# 4. Fastify AI Microservice (apps/ai-service)
# -----------------------------------------------------------------------------
# Port for Fastify dialogue microservice
AI_SERVICE_PORT=3001

# Must match AI_INTERNAL_KEY above to authenticate Colyseus requests
INTERNAL_KEY=ltm_internal_service_token_2026

# OpenAI API Key for tiered LLM dialogue generations (e.g. sk-proj-...)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Strict SLA timeout in milliseconds. If LLM exceeds this, the service cleanly
# aborts and returns the City Pack author's fallback line immediately.
AI_TIMEOUT_MS=1500

# LLM model identifier
OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# 5. Phaser 3 Web Game Client (apps/web)
# -----------------------------------------------------------------------------
# WebSocket connection string for the client browser
VITE_COLYSEUS_WS_URL=ws://localhost:2567

# Optional direct endpoint for AI service
VITE_AI_SERVICE_URL=http://localhost:3001
