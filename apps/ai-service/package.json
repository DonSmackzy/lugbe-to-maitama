{
  "name": "@ltm/ai-service",
  "version": "0.1.0",
  "private": true,
  "description": "Fastify AI dialogue microservice — tiered LLM with Redis caching",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "ts-node --esm src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ltm/protocol": "workspace:*",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.2",
    "openai": "^4.77.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.3"
  }
}
