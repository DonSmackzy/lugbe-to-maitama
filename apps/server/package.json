{
  "name": "@ltm/server",
  "version": "0.1.0",
  "private": true,
  "description": "Colyseus authoritative game server",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "ts-node --esm src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.18",
    "@colyseus/monitor": "^0.18.6",
    "@colyseus/redis-presence": "^0.18.5",
    "@colyseus/schema": "^5.0.36",
    "@colyseus/ws-transport": "^0.18.4",
    "@ltm/city-schema": "workspace:*",
    "@ltm/db": "workspace:*",
    "@ltm/engine": "workspace:*",
    "@ltm/protocol": "workspace:*",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.3"
  }
}
