  "npcArchetypes": [
    {
      "id": "head_of_state",
      "displayName": "The President",
      "spawnZoneTypes": ["restricted", "government"],
      "fallbackDialogue": [
        "My fellow citizen, your perseverance from Lugbe to Maitama is acknowledged.",
        "The state budget has allocated subsidies for resilience. See my Chief of Staff.",
        "Fellow Nigerians, tough decisions today bring a prosperous tomorrow."
      ],
      "interactionScModifier": 500
    },
    {
      "id": "street_trader",
      "displayName": "Street Trader",
      "spawnZoneTypes": ["market", "transport_hub", "residential"],
      "fallbackDialogue": [
        "Oga, buy something now! I no go reduce again.",
        "Customer, see fine goods! Na original I dey sell.",
        "You dey look, you no dey buy? Please na."
      ],
      "interactionScModifier": 2
    },
    {
      "id": "along_driver",
      "displayName": "Along Driver",
      "spawnZoneTypes": ["transport_hub"],
      "fallbackDialogue": [
        "Along! Along! Wuse Along! Lugbe straight!",
        "Pay your money first before you enter my along.",
        "Last chance — we dey move now!"
      ],
      "interactionScModifier": 1
    },
    {
      "id": "civil_servant",
      "displayName": "Civil Servant",
      "spawnZoneTypes": ["government"],
      "fallbackDialogue": [
        "Your file is under review. Come back tomorrow.",
        "The system is down. Try again Monday.",
        "You need form GDR-7 before I can help you."
      ],
      "interactionScModifier": 5
    },
    {
      "id": "enforcement_officer",
      "displayName": "Enforcement Officer",
      "spawnZoneTypes": ["commercial", "market", "transport_hub", "restricted"],
      "fallbackDialogue": [
        "Do you have your papers? Let me see them.",
        "This area requires a permit. Do you have one?",
        "Move along, nothing to see here."
      ],
      "interactionScModifier": -5
    },
    {
      "id": "wealthy_resident",
      "displayName": "Wealthy Resident",
      "spawnZoneTypes": ["residential", "commercial"],
      "fallbackDialogue": [
        "I'm late for a meeting. Please make it quick.",
        "Do you know who I am? I have connections.",
        "My schedule is very busy today."
      ],
      "interactionScModifier": 10
    },
    {
      "id": "market_woman",
      "displayName": "Market Woman",
      "spawnZoneTypes": ["market"],
      "fallbackDialogue": [
        "Oya, I go give you good price. Na my last price!",
        "Come, come! Fresh things just arrive.",
        "God go bless you if you buy from me today."
      ],
      "interactionScModifier": 3
    }
  ],
