{
  "name": "@ltm/db",
  "version": "0.1.0",
  "private": true,
  "description": "PostgreSQL migrations, schema definitions, and DB client factory",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./migrate": {
      "types": "./dist/migrate.d.ts",
      "import": "./dist/migrate.js",
      "require": "./dist/migrate.js",
      "default": "./dist/migrate.js"
    },
    "./migrate.js": {
      "types": "./dist/migrate.d.ts",
      "import": "./dist/migrate.js",
      "require": "./dist/migrate.js",
      "default": "./dist/migrate.js"
    },
    "./package.json": "./package.json",
    "./dist/*": {
      "types": "./dist/*",
      "import": "./dist/*",
      "require": "./dist/*",
      "default": "./dist/*"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "migrate": "node -e \"require('./dist/migrate.js').runMigrations()\"",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "@types/node": "^22.10.2"
  }
}
