{
  "name": "@ltm/engine",
  "version": "0.1.0",
  "private": true,
  "description": "Pure TypeScript simulation engine — zero imports from apps, DOM, window, or fs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./rules": {
      "types": "./dist/rules/index.d.ts",
      "import": "./dist/rules/index.js",
      "require": "./dist/rules/index.js",
      "default": "./dist/rules/index.js"
    },
    "./rules/index.js": {
      "types": "./dist/rules/index.d.ts",
      "import": "./dist/rules/index.js",
      "require": "./dist/rules/index.js",
      "default": "./dist/rules/index.js"
    },
    "./rules/*": {
      "types": "./dist/rules/*.d.ts",
      "import": "./dist/rules/*.js",
      "require": "./dist/rules/*.js",
      "default": "./dist/rules/*.js"
    },
    "./gis": {
      "types": "./dist/gis/index.d.ts",
      "import": "./dist/gis/index.js",
      "require": "./dist/gis/index.js",
      "default": "./dist/gis/index.js"
    },
    "./gis/*": {
      "types": "./dist/gis/*.d.ts",
      "import": "./dist/gis/*.js",
      "require": "./dist/gis/*.js",
      "default": "./dist/gis/*.js"
    },
    "./package.json": "./package.json",
    "./dist/*": {
      "types": "./dist/*",
      "import": "./dist/*",
      "require": "./dist/*",
      "default": "./dist/*"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc --project tsconfig.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ltm/city-schema": "workspace:*",
    "@ltm/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2",
    "vitest": "^5.0.3"
  }
}
